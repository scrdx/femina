# Femina 部署环境变量示例：复制为 .env 后按需修改

# ---- 通用 ----
# 服务端口（宿主机映射）
FEMINA_PORT=8080
# JWT 签名密钥，生产务必改成长随机串
FEMINA_JWT_SECRET=change-me-to-a-long-random-string
# NAS 上照片/视频目录，只读挂载进容器 /media
MEDIA_DIR=/volume1/photos
# 登录有效期（小时），默认 72
#FEMINA_JWT_EXPIRE_HOURS=72

# ---- 模式 A：自带 MySQL（配合 docker-compose.db.yml 使用）----
# 自带实例的 root 密码；app 会自动使用同一个密码连接
MYSQL_ROOT_PASSWORD=femina_db_pass

# ---- 模式 B：外部已有 MySQL（只用 docker-compose.yml 时填写）----
# 不设置时默认连接自带实例（服务名 db）
#FEMINA_DB_HOST=host.docker.internal
#FEMINA_DB_PORT=3306
#FEMINA_DB_NAME=femina
#FEMINA_DB_USER=femina
#FEMINA_DB_PASSWORD=your_password
