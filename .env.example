# Femina 部署环境变量示例：复制为 .env 后按需修改

# ---- 通用 ----
# 宿主机映射端口。默认 8090
FEMINA_PORT=8090
# JWT 签名密钥，生产务必改成长随机串（openssl rand -hex 32）
FEMINA_JWT_SECRET=change-me-to-a-long-random-string
# 照片/视频目录，只读挂载进容器 /media
# 群晖形如 /volume1/photos；威联通形如 /share/Multimedia/photos
MEDIA_DIR=/volume1/photos
# 登录有效期（小时），默认 72
#FEMINA_JWT_EXPIRE_HOURS=72
# 镜像 tag：latest / master / sha-xxxxxxxx（锁定某次 CI 构建，便于回滚）
#FEMINA_IMAGE_TAG=latest

# ---- 模式 A：自带 MySQL（配合 docker-compose.db.yml 使用）----
# 自带实例的 root 密码；app 会自动使用同一个密码连接
MYSQL_ROOT_PASSWORD=femina_db_pass

# ---- 模式 B：外部已有 MySQL（只用 docker-compose.yml 时填写）----
# host 不填时默认 host.docker.internal（宿主机）；连不通可换 172.17.0.1 或宿主机局域网 IP
# MySQL 跑在另一个容器里且没映射宿主端口时，这里填【容器名】，并让两个容器加入同一
# docker network —— 还需给 docker-compose.yml 补 networks 段，见 README「模式 B」的容器变体
#FEMINA_DB_HOST=host.docker.internal
#FEMINA_DB_PORT=3306
#FEMINA_DB_NAME=femina
#FEMINA_DB_USER=femina
#FEMINA_DB_PASSWORD=your_password
